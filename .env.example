# Copy this file to ".env" and edit the values.

# Password you type to log in to the site (this site is for you only).
ACCESS_PASSWORD=changeme

# A long random string used to sign your login cookie.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-a-long-random-string

# How long (in minutes) live data from FotMob/SofaScore is cached before refetch.
CACHE_TTL_MINUTES=30
